# Supabase Project Configuration
# Get these values from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side & Seeding Scripts Only (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# TMDB API v4 Read Access Token (used only by offline seeding scripts in scripts/)
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# Optional Weekly Release Sync Overrides (scripts/seed-weekly.ts)
# DRY_RUN=false
# WEEKLY_LOOKBACK_DAYS=30
# WEEKLY_MOVIES_LIMIT=25
# WEEKLY_TV_LIMIT=25
