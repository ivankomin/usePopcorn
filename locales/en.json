    "help": {
      "title": "Help & FAQ",
      "faq1Question": "How do I build my watchlist?",
      "faq1Answer": "Sign in to your account and click the plus (+) button on any movie or series card, or open its details page to set a status such as Plan to Watch, Watched, or Favorite, or add it to a custom list.",
      "faq2Question": "How do ratings and reviews work?",
      "faq2Answer": "Signed-in users can rate any title on a 1–10 scale (5-star half-step picker) and optionally leave a written review on the title's details page.",
      "faq3Question": "How do I unlock For You recommendations?",
      "faq3Answer": "Once you sign in and interact with at least 3 titles through ratings or your watchlist, your Taste Profile unlocks personalized recommendations tailored to your favorite genres, eras, and formats.",
      "faq4Question": "Where can I manage my profile?",
      "faq4Answer": "Click your avatar in the top-right navigation bar to open your Profile Cabinet, where you can review your stats, edit your username or avatar, manage custom collections, and view your past reviews.",
      "stillNeedHelp": "Still need assistance?",
      "contactLink": "Contact us"
    },
    "privacy": {
      "title": "Privacy Policy",
      "lastUpdated": "Last updated: 2026",
      "section1Title": "Information We Store",
      "section1Body": "When you create an account, we store your email address, chosen username, optional avatar, watchlist entries, custom collections, ratings, and reviews.",
      "section2Title": "How We Use Your Data",
      "section2Body": "Your activity is used strictly to operate your account, display your public reviews, maintain your personal watchlist, and compute your personalized recommendations. We do not sell your personal information to third parties.",
      "section3Title": "Cookies & Sessions",
      "section3Body": "We use essential authentication cookies to keep you signed in and protect your account session, as well as a preference cookie to remember your selected interface language.",
      "section4Title": "Your Control",
      "section4Body": "You can update your profile details, edit or remove your reviews, modify your watchlist, or permanently delete your account at any time from your Profile Settings. When an account is deleted, all personal data (credentials, profile details, avatar, watchlist, and written review text) is removed immediately, while anonymized numeric ratings are retained solely to preserve aggregate catalog scores."
